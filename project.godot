; Tumbang Preso: Philippine Adventure v3.0
; Baseline: Godot 4.7.2-stable
config_version=5

[application]
config/name="Tumbang Preso: Philippine Adventure"
config/description="Offline-first educational 2D province adventure."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[autoload]
AppState="*res://scripts/state/app_state.gd"

