[ext_resource type="PackedScene" path="res://scenes/ui/menu.tscn" id="menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/map.tscn" id="map"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings.tscn" id="settings"]
[ext_resource type="PackedScene" path="res://scenes/ui/progress.tscn" id="progress"]
[ext_resource type="PackedScene" path="res://scenes/ui/credits.tscn" id="credits"]
[ext_resource type="PackedScene" path="res://scenes/ui/confirm.tscn" id="confirm"]
