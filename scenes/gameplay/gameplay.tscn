[ext_resource type="Script" path="res://scripts/ui/island_art.gd" id="art"]
[ext_resource type="Script" path="res://scripts/gameplay/throw_presentation.gd" id="effects"]

[node name="Gameplay" type="Control"]
anchors_preset = 15
anchor_right = 1
anchor_bottom = 1
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1
anchor_bottom = 1
mouse_filter = 2
color = Color(0.094, 0.18, 0.161, 1)

[node name="Backdrop" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("art")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1
anchor_bottom = 1
theme_override_constants/margin_left = 30
theme_override_constants/margin_right = 30
theme_override_constants/margin_top = 16
theme_override_constants/margin_bottom = 16

[node name="Frame" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="HUD" instance=ExtResource("3") parent="Margin/Frame"]
layout_mode = 2
visible = false

[node name="Scroll" type="ScrollContainer" parent="Margin/Frame"]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Panels" type="VBoxContainer" parent="Margin/Frame/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Error" type="Label" parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2
visible = false
theme_override_colors/font_color = Color(1, 0.74, 0.64, 1)
theme_override_font_sizes/font_size = 17
autowrap_mode = 3
text = ""

[node name="Menu" instance=ExtResource("menu") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Map" instance=ExtResource("map") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Settings" instance=ExtResource("settings") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Progress" instance=ExtResource("progress") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Credits" instance=ExtResource("credits") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Confirm" instance=ExtResource("confirm") parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2

[node name="Entry" type="VBoxContainer" parent="Margin/Frame/Scroll/Panels"]
layout_mode = 2
