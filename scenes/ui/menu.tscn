[gd_scene format=3]

[node name="Menu" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 9

[node name="Kicker" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 18
text = "PHILIPPINE ADVENTURE"

[node name="Title" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 52
text = "TUMBANG PRESO"

[node name="Lead" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 19
text = "Choose a province and take on five questions."

[node name="Actions" type="GridContainer" parent="."]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Play" type="Button" parent="Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Play"
size_flags_horizontal = 3

[node name="Continue" type="Button" parent="Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Continue"
size_flags_horizontal = 3

[node name="Settings" type="Button" parent="Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Settings"
size_flags_horizontal = 3

[node name="Credits" type="Button" parent="Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Credits"
size_flags_horizontal = 3

[node name="Saved" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 19
text = ""

[node name="Resume" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Resume saved attempt"
