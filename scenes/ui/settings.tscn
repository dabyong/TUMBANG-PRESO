[gd_scene format=3]

[node name="Settings" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 9

[node name="Title" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 36
text = "Settings"

[node name="MusicLabel" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 19
text = "Music volume"

[node name="Music" type="HSlider" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
max_value = 1
step = 0.05

[node name="EffectsLabel" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 19
text = "Sound effects volume"

[node name="Effects" type="HSlider" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
max_value = 1
step = 0.05

[node name="Motion" type="CheckButton" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Reduced motion"

[node name="Info" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 17
text = "Tumbang Preso is an offline quiz adventure. These controls set the Music and SFX buses for future audio."

[node name="Back" type="Button" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Back"
