extends "res://tests/ui_test_harness.gd"

const Preferences = preload("res://scripts/ui/preferences.gd")

func suite_name() -> String:
    return "Settings and recovery"

func run_checks() -> void:
    await _test_settings()
    await _test_staged()
    _test_committed()
    _test_unsupported()
    _test_preference_recovery()

func _test_settings() -> void:
    var repo := repository("preferences")
    var game := boot_game(repo)
    choose(game, "batanes", "easy")
    tap(game, question(game).correctOptionId)
    var feedback := session(game)
    var fx := game.get_node("Effects")
    press(game, HUD + "Pause")
    press(game, PANELS + "Pause/Settings")
    check(screen_visible(game, "Settings") and fx.suspended, "settings opens from pause without advancing the presentation")
    game.get_node(PANELS + "Settings/Music").value = 0.0
    game.get_node(PANELS + "Settings/Effects").value = 0.35
    game.get_node(PANELS + "Settings/Motion").button_pressed = true
    check(fx.reduced and fx.suspended and session(game) == feedback, "switching motion preference preserves and updates the paused presentation")
    var music := AudioServer.get_bus_index("Music")
    var effects := AudioServer.get_bus_index("SFX")
    check(music >= 0 and effects >= 0 and music != effects and AudioServer.is_bus_mute(music) and is_equal_approx(AudioServer.get_bus_volume_db(effects), linear_to_db(0.35)), "the two persisted controls operate independent Godot buses")
    await capture("17-settings")
    press(game, PANELS + "Settings/Back")
    check(screen_visible(game, "Pause") and session(game) == feedback, "Back returns to the paused session without a save mutation")
    game.get_parent().free()
    game = boot_game(repo)
    press(game, PANELS + "Menu/Actions/Settings")
    check(game.get_node(PANELS + "Settings/Music").value == 0.0 and is_equal_approx(game.get_node(PANELS + "Settings/Effects").value, 0.35) and game.get_node(PANELS + "Settings/Motion").button_pressed, "all three preferences restore from a new boot")
    press(game, PANELS + "Settings/Back")
    resume_saved(game)
    check(session(game) == feedback and game.presentation_state() == "feedback", "restarting from settings restores the committed answer")
    press(game, ACK)
    tap(game, question(game).correctOptionId)
    step(game, 0.15)
    var can := game.get_node(HUD + "TinCan")
    check(game.presentation_state() == "impact" and game.get_node("Effects").reduced and can.spin_radians == 0.0, "reduced motion removes the 720-degree spin")
    step(game, 1.0)
    press(game, ACK)
    for option in wrong_options(game):
        tap(game, option)
        step(game, 1.0)
        press(game, ACK)
    finish_correct(game)
    tap(game, wrong_options(game)[0])
    step(game, 0.30)
    check(game.presentation_state() == "failure" and is_zero_approx(game.get_node("Margin").offset_left), "reduced motion preserves the failure overlay and removes viewport shake")
    step(game, 1.0)
    var saved: Dictionary = game.snapshot()
    var latest := int(repo.load_latest().snapshot.generation)
    var save_path := repo._directory.path_join("tp-save-%d.json" % latest)
    var before := FileAccess.get_file_as_bytes(save_path)
    game.get_parent().free()
    var prefs := Repository.new(repo._directory.path_join("preferences"))
    check(prefs.save({"version": 1, "music": "bad"}), "malformed preferences are isolated from gameplay storage")
    game = boot_game(repo)
    press(game, PANELS + "Menu/Actions/Settings")
    check(is_equal_approx(game.get_node(PANELS + "Settings/Music").value, 0.8) and not game.get_node(PANELS + "Settings/Motion").button_pressed, "malformed preferences use defaults")
    check(game.snapshot() == saved and FileAccess.get_file_as_bytes(save_path) == before, "preference fallback leaves gameplay snapshot bytes intact")
    game.get_parent().free()

func _test_staged() -> void:
    var repo := repository("staged-promotion")
    var checkpoint := _seed(repo)
    write_generation(repo, 2, "pending", checkpoint)
    var game := boot_game(repo)
    check(screen_visible(game, "Diagnostic") and game.get_node(PANELS + "Diagnostic/Details").text.contains("Inspection snapshot 1"), "recovery displays the verified inspection snapshot")
    await capture("18-save-recovery")
    press(game, PANELS + "Diagnostic/Actions/Promote")
    check(screen_visible(game, "Confirm") and repo.load_latest().stagedGeneration == 2, "promotion waits for explicit confirmation")
    press(game, PANELS + "Confirm/Cancel")
    check(screen_visible(game, "Diagnostic") and repo.load_latest().snapshot.generation == 1, "cancelling promotion preserves the committed generation")
    press(game, PANELS + "Diagnostic/Actions/Promote")
    press(game, PANELS + "Confirm/Accept")
    check(screen_visible(game, "Menu") and repo.load_latest().snapshot.generation == 2 and game.snapshot() == checkpoint, "confirmed stage promotion re-enables navigation")
    game.get_parent().free()

    repo = repository("staged-deferral")
    checkpoint = _seed(repo)
    write_generation(repo, 2, "pending", {"bad": true})
    var before := FileAccess.get_file_as_bytes(repo._directory.path_join("tp-save-2.pending"))
    game = boot_game(repo)
    check(not game.has_node(PANELS + "Diagnostic/Actions/Promote") and game.get_node(PANELS + "Diagnostic/Details").text.contains("Pending save:"), "malformed staged payload exposes its reason and disables promotion")
    press(game, PANELS + "Diagnostic/Actions/Defer")
    press(game, PANELS + "Confirm/Accept")
    check(screen_visible(game, "Menu") and game.snapshot() == checkpoint and FileAccess.get_file_as_bytes(repo._directory.path_join("tp-save-2.deferred")) == before, "confirmed deferral preserves staged bytes and continues committed gameplay")
    game.get_parent().free()

func _test_committed() -> void:
    var repo := repository("committed-recovery")
    var checkpoint := _seed(repo)
    check(repo.save({}), "test creates a checksum-valid but invalid generation")
    var game := boot_game(repo)
    check(screen_visible(game, "Diagnostic") and game.has_node(PANELS + "Diagnostic/Actions/Restore1"), "older compatible generation is offered without selection")
    press(game, PANELS + "Diagnostic/Actions/Restore1")
    check(screen_visible(game, "Confirm") and game.get_node(PANELS + "Confirm/Details").text.contains("rolled back") and repo.load_latest().highestGeneration == 2, "rollback confirmation discloses the effect before applying")
    check(repo.save({}), "test changes the latest committed generation before confirmation")
    press(game, PANELS + "Confirm/Accept")
    check(screen_visible(game, "Diagnostic") and game.get_node(PANELS + "Error").text.contains("stale recovery decision") and repo.load_latest().highestGeneration == 3, "stale recovery confirmation is rejected without publication")
    press(game, PANELS + "Diagnostic/Actions/Restore1")
    press(game, PANELS + "Confirm/Accept")
    check(screen_visible(game, "Menu") and game.snapshot() == checkpoint and repo.load_latest().snapshot.generation == 4 and FileAccess.file_exists(repo._directory.path_join("tp-save-3.json")), "fresh rollback publishes a new checkpoint and keeps the rejected generation")
    game.get_parent().free()

func _test_unsupported() -> void:
    var repo := repository("future-schema")
    var checkpoint := _seed(repo)
    write_generation(repo, 2, "pending", checkpoint, Repository.SCHEMA_VERSION + 1)
    var game := boot_game(repo)
    check(screen_visible(game, "Diagnostic") and not game.has_node(PANELS + "Diagnostic/Actions/Promote") and not game.has_node(PANELS + "Diagnostic/Actions/Defer") and game.get_node(PANELS + "Diagnostic/Details").text.contains("No compatible recovery action"), "future schema exposes preservation guidance and no mutation action")
    press(game, PANELS + "Diagnostic/Retry")
    check(screen_visible(game, "Diagnostic") and repo.load_latest().writeBlocked and FileAccess.file_exists(repo._directory.path_join("tp-save-2.pending")), "recheck preserves future-schema data")
    game.get_parent().free()

func _seed(repo: Repository) -> Dictionary:
    var store := Store.new(repo, campaign, catalog)
    store.restore()
    check(store.start_session("existing", "batanes", "easy") == "", "fixture contains a committed session")
    return store.snapshot()

func _test_preference_recovery() -> void:
    var game_repo := repository("preferences-interrupted")
    _seed(game_repo)
    var game_path := game_repo._directory.path_join("tp-save-1.json")
    var game_bytes := FileAccess.get_file_as_bytes(game_path)
    var path := game_repo._directory.path_join("preferences")
    check(DirAccess.make_dir_absolute(path) == OK, "isolated preferences directory exists")
    var prefs_repo := Repository.new(path)
    var candidate := Preferences.DEFAULTS.duplicate()
    candidate.music = 0.25
    write_generation(prefs_repo, 1, "pending", candidate)
    var prefs := Preferences.new(game_repo._directory)
    check(prefs.values.music == 0.25 and prefs_repo.load_latest().snapshot.generation == 1, "compatible first interrupted preferences are promoted on restart")
    candidate.effects = 0.35
    write_generation(prefs_repo, 2, "pending", candidate)
    prefs = Preferences.new(game_repo._directory)
    check(prefs.values.effects == 0.35 and prefs_repo.load_latest().stagedGeneration == 0, "newest compatible staged settings are applied exactly once")
    write_generation(prefs_repo, 3, "pending", {"version": 1, "music": "invalid"})
    var malformed := FileAccess.get_file_as_bytes(path.path_join("tp-save-3.pending"))
    prefs = Preferences.new(game_repo._directory)
    check(prefs.values.music == 0.25 and prefs.values.effects == 0.35, "malformed stage keeps the valid committed settings")
    check(FileAccess.get_file_as_bytes(path.path_join("tp-save-3.deferred")) == malformed, "malformed staged envelope is preserved byte for byte")
    check(prefs.update("reduced_motion", true) and prefs_repo.load_latest().snapshot.generation == 4, "an edit safely publishes beyond the deferred generation")
    check(Preferences.new(game_repo._directory).values.reduced_motion, "subsequent edits survive a restart")
    var future := candidate.duplicate()
    future.version = Preferences.VERSION + 1
    write_generation(prefs_repo, 5, "pending", future)
    var future_bytes := FileAccess.get_file_as_bytes(path.path_join("tp-save-5.pending"))
    prefs = Preferences.new(game_repo._directory)
    check(prefs.values.reduced_motion and FileAccess.get_file_as_bytes(path.path_join("tp-save-5.deferred")) == future_bytes, "unsupported staged payload version is preserved without being applied")
    check(prefs.update("effects", 0.6) and prefs_repo.load_latest().snapshot.generation == 6, "an archived future payload does not block safe supported writes")
    write_generation(prefs_repo, 7, "json", future)
    prefs = Preferences.new(game_repo._directory)
    check(prefs.storage_error == "unsupported preferences version" and prefs.values.effects == 0.6 and not prefs.update("music", 0.4) and prefs_repo.load_latest().snapshot.generation == 7, "unsupported committed payload version keeps compatible display values and blocks edits")
    write_generation(prefs_repo, 8, "pending", candidate, Repository.SCHEMA_VERSION + 1)
    prefs = Preferences.new(game_repo._directory)
    check(prefs.storage_error == "unsupported preference save schema" and not prefs.update("music", 0.8) and FileAccess.file_exists(path.path_join("tp-save-8.pending")), "unknown envelope schema blocks edits and remains intact even for a no-op request")
    check(FileAccess.get_file_as_bytes(game_path) == game_bytes and game_repo.load_latest().highestGeneration == 1, "preference recovery preserves all gameplay bytes and generations")

    var fresh_repo := repository("preferences-partial")
    path = fresh_repo._directory.path_join("preferences")
    check(DirAccess.make_dir_absolute(path) == OK, "isolated first-write directory exists")
    var partial := FileAccess.open(path.path_join("tp-save-1.pending"), FileAccess.WRITE)
    partial.store_string("unfinished bytes")
    partial.close()
    prefs = Preferences.new(fresh_repo._directory)
    check(prefs.values == Preferences.DEFAULTS and prefs.update("music", 0.5), "first incomplete publication allows an explicit fresh preferences edit")
    var archived := false
    for directory in DirAccess.get_directories_at(fresh_repo._directory):
        if directory.begins_with("preferences-preserved-"):
            archived = FileAccess.get_file_as_string(fresh_repo._directory.path_join(directory).path_join("tp-save-1.pending")) == "unfinished bytes"
    check(archived and Preferences.new(fresh_repo._directory).values.music == 0.5, "first-write damage is preserved in its archived directory")
    var exhausted := Repository.new(path)
    var last := prefs.values.duplicate()
    write_generation(exhausted, Repository.MAX_GENERATION, "json", last)
    var updated := prefs.update("music", 0.9)
    check(not updated and prefs.storage_error == "could not publish preferences" and prefs.values.music == 0.5, "failed publication leaves the proposed values unapplied (%s, %s, %s)" % [updated, prefs.storage_error, prefs.values.music])
